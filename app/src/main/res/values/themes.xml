<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.SupportFlow" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <!-- Atributos globais ficam em Theme.SupportFlow (e nao em Base) porque
         values-night/themes.xml redefine Base.Theme.SupportFlow vazio; se os
         atributos estivessem em Base, sumiriam no modo escuro. -->
    <style name="Theme.SupportFlow" parent="Base.Theme.SupportFlow">
        <item name="colorPrimary">@color/brand_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/brand_navy</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorSurfaceVariant">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/border_card</item>
        <item name="colorOutlineVariant">@color/border_card</item>
        <item name="android:colorBackground">@color/screen_background</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="android:windowBackground">@color/screen_background</item>
    </style>
</resources>
